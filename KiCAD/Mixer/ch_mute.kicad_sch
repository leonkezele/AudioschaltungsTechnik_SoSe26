	(text "https://www.sound-au.com/articles/muting.html"
		(exclude_from_sim no)
		(at 54.356 106.934 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "acaa3889-549d-49f2-a81f-7837d2cbd86d")
	)
	(text "If a JFET has an on-resistance of 30Ω, the maximum attenuation with a 2.2k\nsource impedance is 37dB.  This isn't enough, and you will need to use\ntwo JFETs as shown to get a high enough mute ratio.  This is at the\nexpense of total source resistance though.  With the dual-stage circuit\nshown above, the mute level will be around -70dB.  It is possible to\nreduce the value of the two resistors (to around 1kΩ) which will reduce\nthe muted level to around -60dB, which is probably sufficient for most\npurposes."
		(exclude_from_sim no)
		(at 63.754 23.876 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f8f4565a-3588-40e9-8d3a-159db848c0bf")
	)
